# ==========================================================================
# FRIDAY - environment configuration
#
# SECURITY: never prefix a secret with VITE_. Vite inlines every VITE_*
# variable into the browser bundle, which makes the value public. The guard
# in vite.config.js refuses to start if it finds a secret-like VITE_ variable.
# ==========================================================================

# --- AI engine routing ---
# FLOW: cloud first, local fallback. The cloud provider (OpenRouter by default)
# is ALWAYS the primary link; the local Ollama model automatically takes over
# when the cloud link fails, times out, or is unconfigured. No restart needed -
# the switch is per reply. Set AI_PROVIDER=ollama ONLY to force local-first.
# AI_PROVIDER=ollama
AI_PROVIDER=openrouter

# --- OpenRouter (cloud, default provider). Key stays server-side. ---
# Any OpenAI-compatible endpoint works: point OPENROUTER_BASE_URL elsewhere
# (Groq, Together, a local gateway, ...) if you prefer a different cloud link.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Groq (OPTIONAL: voice STT and the vision fallback).
# OpenRouter has no STT endpoint, so Groq Whisper is the only server-side
# transcription path; without the key the browser Web Speech API is used.
# Groq is also the automatic fallback for vision (see below). ---
# GROQ_API_KEY=your_groq_api_key_here

# --- Vision (screen/screenshot analysis) ---
# Primary provider is OpenRouter, reusing OPENROUTER_API_KEY (no extra config).
# If it fails or is unconfigured, the Groq fallback above is tried. Any
# OpenAI-compatible multimodal endpoint works via VISION_BASE_URL.
# VISION_PROVIDER=openrouter                 # openrouter | groq
# VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
# VISION_BASE_URL=https://openrouter.ai/api/v1
# VISION_API_KEY=...                         # defaults to OPENROUTER_API_KEY
# VISION_FALLBACK_PROVIDER=groq              # set to "none" to disable
# VISION_FALLBACK_MODEL=qwen/qwen3.8-27b
# VISION_TIMEOUT_MS=20000

# --- ElevenLabs voice (optional; the browser voice is used if absent) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Ollama (local alternative to Groq) ---
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1