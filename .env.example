# ==========================================================================
# FRIDAY - environment configuration
#
# SECURITY: never prefix a secret with VITE_. Vite inlines every VITE_*
# variable into the browser bundle, which makes the value public. The guard
# in vite.config.js refuses to start if it finds a secret-like VITE_ variable.
# ==========================================================================

# --- AI engine routing ---
# FLOW: cloud first, local fallback. Groq (cloud) is ALWAYS the primary link;
# the local Ollama model automatically takes over when the cloud link fails,
# times out, or is unconfigured. No restart needed - the switch is per reply.
# Set AI_PROVIDER=ollama ONLY to force local-first (e.g. offline work).
# AI_PROVIDER=ollama
AI_PROVIDER=groq

# --- Groq (cloud, default provider). Key stays server-side. ---
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- ElevenLabs voice (optional; the browser voice is used if absent) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Ollama (local alternative to Groq) ---
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1